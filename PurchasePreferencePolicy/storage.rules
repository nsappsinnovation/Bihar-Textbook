// ---------------------------------------------------------------------------
// IMPORTANT: Storage rules are shared by every app in the Firebase project
// (carbonfootprint-69ba7). This file = the BRLPP storage rules (unchanged) +
// the Purchase Preference block. Keep both repositories' storage.rules identical.
// ---------------------------------------------------------------------------
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() { return request.auth != null ? request.auth.token.get('role', '') : ''; }
    function citizenMobile() {
      return request.auth != null
          && request.auth.token.get('email', '').matches('^[6-9][0-9]{9}@citizen[.]brlpp[.]local$')
        ? request.auth.token.email.split('@')[0] : '';
    }

    match /land-photos/{mobile}/{batch}/{file} {
      allow read: if citizenMobile() == mobile
        || role() == 'state' || role() == 'district';
      allow create: if citizenMobile() == mobile
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // ---------------- Bihar Purchase Preference portal ----------------
    // Optional unit photos, one folder per citizen account (Firebase uid).
    // Identities are separate from BRLPP: "<mobile>@citizen.bppp.local" and ppRole claims.
    function ppRole() { return request.auth != null ? request.auth.token.get('ppRole', '') : ''; }
    function ppIsCitizen() {
      return request.auth != null
        && request.auth.token.get('email', '').matches('^[6-9][0-9]{9}@citizen[.]bppp[.]local$');
    }

    match /PurchasePolicy/unit-photos/{uid}/{file} {
      allow read: if (ppIsCitizen() && request.auth.uid == uid)
        || ppRole() == 'state' || ppRole() == 'district';
      allow create: if ppIsCitizen() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Owners may delete photos they remove from their registration.
      allow delete: if ppIsCitizen() && request.auth.uid == uid;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
